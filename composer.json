{
  "name": "fingoweb/speedtest",
  "description": "Fork of the Fingoweb Speedtest package: A Laravel-compatible package for speedtest functionalities.",
  "type": "library",
  "license": "LGPL-3.0-or-later",
  "authors": [
    {
      "name": "Kamil Staśko",
      "email": "kamil.stasko@fingoweb.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "Fingoweb\\Speedtest\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Fingoweb\\Speedtest\\SpeedtestServiceProvider"
      ],
      "aliases": {
        "Speedtest": "Fingoweb\\Speedtest\\Facades\\Speedtest"
      }
    }
  },
  "require": {
    "php": ">=7.4",
    "illuminate/support": "^7.0|^8.0|^9.0|^10.0",
    "guzzlehttp/guzzle": "^7.0"
  }
}
